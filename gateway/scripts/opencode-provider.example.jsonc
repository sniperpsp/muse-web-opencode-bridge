// Dentro de "provider" no ~/.config/opencode/opencode.jsonc.
// A chave do gateway geral fica em ~/.config/gateway/key; NVIDIA usa nvidia.key.
"gateway": {
  "npm": "@ai-sdk/anthropic",
  "name": "GT Pontes Web",
  "options": {
    "baseURL": "http://127.0.0.1:4350/v1",
    "apiKey": "{file:~/.config/gateway/key}",
    "timeout": 600000,
    "headerTimeout": 600000
  },
  "models": {
    // context baixo de propósito: o OpenCode resume a sessão antes de o histórico passar do limite das pontes
    "gt-auto": { "name": "GT Auto", "limit": { "context": 80000, "output": 16000 } }
  }
},

// NVIDIA direto: cada provedor fixa UM modelo ("GT NVIDIA <modelo>"); a parte
// cinza do seletor (nome do provedor) diz para que ele é bom. Gerado a partir de
// instalar.py (NVIDIA_MODELS) — rode `python3 instalar.py --nvidia` em vez de copiar.
// A chave NUNCA fica aqui: é lida de ~/.config/gateway/nvidia.key (gt-nvidia-key).
"nvidia-nemotron-ultra": {
  "npm": "@ai-sdk/openai-compatible",
  "name": "Melhor p/ texto · só texto",
  "options": {
    "baseURL": "https://integrate.api.nvidia.com/v1",
    "apiKey": "{file:~/.config/gateway/nvidia.key}",
    "timeout": 600000,
    "headerTimeout": 600000
  },
  "models": {
    "nvidia/nemotron-3-ultra-550b-a55b": {
      "name": "GT NVIDIA Ultra 550B",
      "tool_call": true,
      "attachment": false,
      "modalities": {
        "input": [
          "text"
        ],
        "output": [
          "text"
        ]
      },
      "limit": {
        "context": 120000,
        "output": 16000
      }
    }
  }
},
"nvidia-nemotron-super-vl": {
  "npm": "@ai-sdk/openai-compatible",
