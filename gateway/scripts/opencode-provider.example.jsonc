// Dentro de "provider" no ~/.config/opencode/opencode.jsonc.
// A chave do gateway geral fica em ~/.config/gateway/key; NVIDIA usa nvidia.key.
"gateway": {
  "npm": "@ai-sdk/anthropic",
  "name": "GT Pontes Web",
  "options": {
    "baseURL": "http://127.0.0.1:4350/v1",
    "apiKey": "{file:~/.config/gateway/key}",
    "timeout": 600000,
    "headerTimeout": 600000
  },
  "models": {
    // context baixo de propósito: o OpenCode resume a sessão antes de o histórico passar do limite das pontes
    "gt-auto": { "name": "GT Auto", "limit": { "context": 80000, "output": 16000 } }
  }
},

// NVIDIA direto: cada provedor fixa um modelo; o instalador cria estes blocos.
"nvidia-mistral": {
  "npm": "@ai-sdk/openai-compatible",
  "name": "NVIDIA Mistral Large 4",
  "options": {
    "baseURL": "https://integrate.api.nvidia.com/v1",
    "apiKey": "{file:~/.config/gateway/nvidia.key}",
    "timeout": 600000,
    "headerTimeout": 600000
  },
  "models": {
    "mistralai/mistral-large-4-1t-a52b": {
      "name": "NVIDIA Mistral Large 4",
      "tool_call": true,
      "attachment": true,
      "modalities": {
        "input": [
          "text",
          "image"
        ],
        "output": [
          "text"
        ]
      },
      "limit": {
        "context": 120000,
        "output": 16000
      }
    }
  }
},
