# Configuração de desempenho da ponte, versionada: todo mundo que atualiza o repositório usa estes valores.
# Para mudar, edite este arquivo e recrie a ponte (docker compose up -d).
MUSE_MAX_PROMPT_CHARS=500000
MUSE_REQUEST_TIMEOUT_MS=420000
MUSE_HISTORY_CHARS=80000
MUSE_MAX_TABS=3
MUSE_ROTATE_TURNS=40
MUSE_ROTATE_CHARS=250000
