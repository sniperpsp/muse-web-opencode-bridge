# Configuração de desempenho do bridge do ChatGPT (versionada).
# Menor que a do Muse: o campo do chatgpt.com é contenteditable e trava o Chromium com texto grande.
# Para mudar, edite este arquivo e recrie a ponte (docker compose up -d).
MUSE_MAX_PROMPT_CHARS=100000
MUSE_REQUEST_TIMEOUT_MS=420000
MUSE_HISTORY_CHARS=50000
MUSE_ROTATE_TURNS=25
MUSE_ROTATE_CHARS=120000
